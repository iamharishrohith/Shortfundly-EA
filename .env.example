# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE CONFIGURATION (LOCAL SQLITE WAL ENGINE)
# ------------------------------------------------------------------------------
SQLITE_DB_PATH=./logs/next_dispatch_audit.db
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_CACHE_SIZE=-64000
DATABASE_TABLE_ACTIVE_COLLEGES=active_colleges
DATABASE_TABLE_DISPATCH_AUDIT=dispatch_audit
DATABASE_TABLE_SMTP_ACCOUNTS=smtp_accounts
DATABASE_TABLE_ACTIVE_TEMPLATE=active_template

# ------------------------------------------------------------------------------
# 5. DISPATCH THROTTLER & SECURITY CONTROLS
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_PORT=3000
MAX_DISPATCH_RATE=2
RATE_DELTA_MS=500
CONNECTION_POOLING=true
POOL_MAX_CONNECTIONS=5
POOL_MAX_MESSAGES=100
IDEMPOTENCY_ALGORITHM=SHA-256
PREFLIGHT_DNS_MX_CHECK=true
DNS_RESOLVER_TIMEOUT_MS=3000
ENABLE_EMERGENCY_KILL_SWITCH=true
EXCEL_AUDIT_EXPORT_FORMAT=xlsx

# ------------------------------------------------------------------------------
# 6. APPLICATION METRICS & AUDIT SNAPSHOT
# ------------------------------------------------------------------------------
INSTITUTIONAL_DIRECTORY_COUNT=1531 Verified Records
VERIFIED_TEST_DISPATCHES=2
TOTAL_ROUTES_COMPILED=23 Next.js Routes (Exit Code 0)
