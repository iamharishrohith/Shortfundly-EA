# Environment Variables for College Email Automation
# Copy this file to .env and fill in your real credentials

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@shortfundly.com
SMTP_PASSWORD=your_app_password_or_token
FROM_EMAIL=outreach@shortfundly.com
FROM_NAME="Shortfundly Education Outreach"
REPLY_TO=contact@shortfundly.com

# Safety Flags
DRY_RUN=true
TEST_MODE=true
